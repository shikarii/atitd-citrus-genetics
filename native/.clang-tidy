---
# Pedantic clang-tidy configuration — mirrors Python's "ruff select ALL" philosophy.
# Enable all check families, then disable specific checks with documented reasons.

Checks: >
  *,
  -abseil-*,
  -altera-*,
  -android-*,
  -fuchsia-*,
  -google-readability-todo,
  -llvmlibc-*,
  -objc-*,
  -zircon-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -misc-no-recursion,
  -hicpp-no-assembler,
  -bugprone-easily-swappable-parameters,
  -cert-dcl50-cpp

# Treat all enabled checks as errors (zero-warning policy)
WarningsAsErrors: "*"

HeaderFilterRegex: "include/citrus/.*\\.h$"

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: 25
  - key: readability-function-size.LineThreshold
    value: 100
  - key: readability-function-size.StatementThreshold
    value: 50
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: true
  - key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: true
  - key: performance-unnecessary-value-param.AllowedTypes
    value: "std::string_view"
  - key: modernize-use-nodiscard.ReplacementString
    value: "[[nodiscard]]"
...
