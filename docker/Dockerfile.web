# syntax=docker/dockerfile:1
# Multi-stage build. Runtime target: < 50 MB.
# Stage 1 (build): node:22-alpine — npm build produces static assets.
# Stage 2 (runtime): nginx:alpine — serves static assets and proxies /api/.

# ---- Build stage ----
FROM node:22-alpine AS build

WORKDIR /build

# Install dependencies before copying source so this layer is cached on dep-only changes.
COPY web/package.json web/package-lock.json* ./
RUN npm ci --ignore-scripts

COPY web/ ./
RUN npm run build

# ---- Runtime stage ----
FROM nginx:alpine AS runtime

# Remove the default nginx config and replace with the project-specific one.
RUN rm /etc/nginx/conf.d/default.conf
COPY docker/nginx.conf /etc/nginx/conf.d/citrus.conf

# Copy the built static assets from the build stage.
COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 80

# wget is included in nginx:alpine; no need to install curl.
HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=5s \
    CMD wget -q --spider http://localhost:80/ || exit 1
